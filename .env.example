# Copy to `.env` for local runs (`.env` is gitignored). Loaded at startup via
# dotenvy; real deployments set these directly in the environment instead.

# Log verbosity — EnvFilter syntax. Unset/empty falls back to `info`.
# e.g. `debug`, `info`, `discord_relay=debug,reqwest=warn`
RUST_LOG=discord_relay=debug

# Log encoding: `json` for one object per line; anything else = human-readable.
LOG_FORMAT=
